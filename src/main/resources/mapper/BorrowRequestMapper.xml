<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kk.rbac.mapper.BorrowRequestMapper">

    <select id="selectExpiredIds" resultType="java.lang.Integer">
        SELECT id
        FROM borrow_request
        WHERE status = 'approved'
        AND approve_time &lt; #{approveTimeBefore}
        AND id &gt; #{afterId}
        ORDER BY id
        LIMIT 200
    </select>

</mapper>